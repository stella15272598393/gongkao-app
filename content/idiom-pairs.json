    {
      "id": 1,
      "a": {
        "word": "一蹴而就",
        "pinyin": "yī cù ér jiù",
        "meaning": "蹴：踏；就：成功。踏一步就成功。比喻事情轻而易举，一下子就成功。",
        "source": "汉典",
        "verified": "汉典"
      },
      "b": {
        "word": "一挥而就",
        "pinyin": "yī huī ér jiù",
        "meaning": "形容才思敏捷，一动笔就能完成",
        "source": "汉典",
        "verified": "汉典"
      },
      "tags": [
        "近义辨析"
      ],
      "note": "「就」都指「成功」；前者说事易成，后者说写画快。",
      "verified": true
    },
    {
      "id": 2,
      "a": {
        "word": "不以为然",
        "pinyin": "bù yǐ wéi rán",
        "meaning": "不认为是正确的，表示不同意",
        "source": "汉典",
        "verified": "汉典"
      },
      "b": {
        "word": "不以为意",
        "pinyin": "bù yǐ wéi yì",
        "meaning": "不把事情放在心上",
        "source": "汉典",
        "verified": "汉典"
      },
      "tags": [
        "近义辨析"
      ],
      "note": "然=对（不认同）；意=在意（不重视）。最常考一对。",
      "verified": true
    },
    {
      "id": 3,
      "a": {
        "word": "潜移默化",
